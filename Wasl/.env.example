# Copy to .env and adjust
# Phase 1 memory mode needs no services or database. Never use memory in production.
WASL_STORAGE_DRIVER=memory
# Required in memory mode only. Set a fictional, local-only 12..72 byte password.
WASL_DEV_PASSWORD=
# For Prisma mode use apps/api/.env.prisma.example. Supply migration credentials only to Prisma CLI.
# Generate two distinct random secrets, each at least 32 characters; no built-in defaults.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
API_PORT=4000
CORS_ORIGINS=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=wasl
S3_SECRET_KEY=wasl-secret
S3_BUCKET=wasl
REDIS_URL=redis://localhost:6379
WASL_API_URL=http://127.0.0.1:4000/api/v1
WASL_WEB_ORIGIN=http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
