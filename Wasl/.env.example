# Copy to .env and adjust
DATABASE_URL=postgresql://wasl_app:wasl_app@localhost:5432/wasl
# Owner role, used only for migrations (bypasses row-level security)
MIGRATION_DATABASE_URL=postgresql://wasl:wasl@localhost:5432/wasl
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
API_PORT=4000
CORS_ORIGINS=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=wasl
S3_SECRET_KEY=wasl-secret
S3_BUCKET=wasl
REDIS_URL=redis://localhost:6379
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
