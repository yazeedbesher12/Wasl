# Copy this file to .env.postgres.local and replace every empty value.
# Keep the local file private; it is ignored by Git. Use lowercase hex so the
# values are URL-safe. Database/admin passwords require 48 hex characters;
# signing and JWT keys require 64 hex characters.
WASL_DEV_POSTGRES_PORT=55437
WASL_DEV_MIGRATOR_PASSWORD=
WASL_DEV_AUTH_PASSWORD=
WASL_DEV_PLATFORM_PASSWORD=
WASL_DEV_TENANT_PASSWORD=
WASL_DEV_ACADEMIC_ADMIN_PASSWORD=
WASL_DEV_ASSESSMENT_STAFF_PASSWORD=
WASL_DEV_ADMIN_PASSWORD=
WASL_SUBJECT_PROOF_KEY=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
API_PORT=4000
CORS_ORIGINS=http://localhost:3000
WASL_FILES_DIR=./.wasl-data/postgres-dev-files
