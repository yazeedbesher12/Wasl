NODE_ENV=development
WASL_STORAGE_DRIVER=memory
WASL_DEV_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
API_PORT=4000
CORS_ORIGINS=http://localhost:3000
# DATABASE_URL and MIGRATION_DATABASE_URL are not required in this mode.

# Actual private files: local development storage. Never serve this directory publicly.
WASL_FILE_STORAGE_DRIVER=local
WASL_FILES_DIR=./.wasl-data/files
# For MinIO/S3 use WASL_FILE_STORAGE_DRIVER=s3 and configure the private bucket:
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=wasl-private
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# Production requires S3, an HTTPS endpoint (if supplied), and persistent Prisma storage.
