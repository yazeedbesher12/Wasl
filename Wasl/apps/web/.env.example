# Server-only API address; the browser uses the same-origin /api/wasl proxy.
WASL_API_URL=http://127.0.0.1:4000/api/v1
# Set to the exact external origin when running behind a reverse proxy.
WASL_WEB_ORIGIN=http://localhost:3000
# Production requires explicit single-process session storage configuration.
WASL_WEB_SESSION_MODE=single-instance
